    Add metric for storage usage (#7376)
    
    Issue: #7368
    
    This PR simply uses the available methods of the StorageUsage interface
    for new metrics. The new metrics:
    
    - Total Space
    - Usable Space
    - Used Space
    
    for
    
    - Asset Manager
    - Workspace
    - Working File Repository
    
    Here an example:
    
    ```properties
    # TYPE opencast_storage_available gauge
    # HELP opencast_storage_available Shows available and used up space of different directories of Opencast.
    opencast_storage_available{part="OsgiFileSystemAssetStore_usedSpace"} 0.0
    opencast_storage_available{part="WorkingFileRepositoryRestEndpoint_usedSpace"} 0.0
    opencast_storage_available{part="WorkspaceImpl_totalSpace"} 1.021414735872E12
    opencast_storage_available{part="WorkingFileRepositoryRestEndpoint_usableSpace"} 9.23058225152E11
    opencast_storage_available{part="OsgiFileSystemAssetStore_usableSpace"} 9.23058225152E11
    opencast_storage_available{part="WorkspaceImpl_usedSpace"} 0.0
    opencast_storage_available{part="WorkingFileRepositoryRestEndpoint_totalSpace"} 1.021414735872E12
    opencast_storage_available{part="WorkspaceImpl_usableSpace"} 9.23058225152E11
    opencast_storage_available{part="OsgiFileSystemAssetStore_totalSpace"} 1.021414735872E12
    ```
    
